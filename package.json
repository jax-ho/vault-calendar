{
	"name": "obsidian-calendar-view",
	"version": "0.1.0",
	"private": true,
	"description": "A local-first calendar view for dated Markdown notes in Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "npm test && npm run lint && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": ["obsidian", "obsidian-plugin", "calendar", "markdown"],
	"author": "Jax Ho",
	"license": "0-BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jax-ho/obsidian-calendar-view.git"
	},
	"bugs": {
		"url": "https://github.com/jax-ho/obsidian-calendar-view/issues"
	},
	"homepage": "https://github.com/jax-ho/obsidian-calendar-view#readme",
	"engines": {
		"node": ">=20.19.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	}
}
